# Smart Milk ATM Configuration

# Server & Hosting
PORT=3000
APP_BASE_URL="http://localhost:3000"

# Application Mode:
# Keep DEMO_MODE="true" until Razorpay live webhooks, HTTPS APP_BASE_URL, and physical ESP32 safety checks are complete.
# Set to "false" ONLY when ready for real Razorpay payments and physical hardware dispensing.
DEMO_MODE="true"

# Razorpay Payment Gateway Credentials (Backend-Only, NEVER expose in frontend or commit real secrets)
# Obtain genuine Live or Test keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# IoT Hardware & ESP32 Security (Set a strong custom secret in production hosting env)
DEVICE_AUTH_SECRET="replace_with_strong_esp32_device_secret"
DEFAULT_MACHINE_ID="ATM-KA-001"

# Firebase Admin Service Account Credentials (Backend-Only, OPTIONAL)
# When not provided, the app operates in local in-memory/file persistence mode.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
